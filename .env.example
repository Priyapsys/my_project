# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/globalpay

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── JWT Authentication ───────────────────────────────────────
# REQUIRED: Secret key used to sign/verify JWTs. Hard error if not set!
#   Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret
# Token expiration (default: 1h). Uses ms/zeit format: 60s, 15m, 1h, 7d, etc.
JWT_EXPIRES_IN=1h

# ── Solana (Settlement) ─────────────────────────────────────
# SOLANA_KEYPAIR_PATH=.wallet.json
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Stripe (Bank Integration Layer) ─────────────────────────
# REQUIRED for deposits & withdrawals (test mode only).
# Obtain a free test mode key from: Stripe dashboard → Developers → API keys (test mode).
# Must start with sk_test_. Live keys (sk_live_...) are strictly prohibited.
STRIPE_TEST_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Proxy ────────────────────────────────────────────────────
# Set to true when behind a reverse proxy (Nginx, Cloudflare, etc.)
# so rate limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated browser origins. In production, set this explicitly.
CORS_ORIGINS=http://localhost:5173

# ── Credentials ─────────────────────────────────────────────
# Required in production; development defaults are demo-only.
SEED_USER_PASSWORD=change-this-development-seed-password
TEST_USER_PASSWORD=change-this-development-test-password
