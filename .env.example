# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/globalpay

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── JWT Authentication ───────────────────────────────────────
# REQUIRED: Secret key used to sign/verify JWTs. Use a strong random string.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret
# Token expiration (default: 1h). Uses ms/zeit format: 60s, 15m, 1h, 7d, etc.
JWT_EXPIRES_IN=1h

# ── Solana (Settlement) ─────────────────────────────────────
# SOLANA_KEYPAIR_PATH=.wallet.json
# SOLANA_RPC_URL=https://api.devnet.solana.com
