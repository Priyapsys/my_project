{
  "name": "global-payment-system",
  "version": "1.1.0",
  "description": "Production-grade real-time global payment system with blockchain-anchored settlement",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --config jest.config.ts --runInBand",
    "test:unit": "jest --config jest.config.ts tests/unit",
    "test:integration": "jest --config jest.config.ts tests/integration",
    "test:integration:chain": "jest --config jest.config.ts tests/integration/chain.test.ts",
    "test:flow": "bash scripts/test_flow.sh",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "migrate": "knex --knexfile src/db/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/db/knexfile.ts migrate:rollback"
  },
  "dependencies": {
    "@solana/spl-memo": "^0.2.5",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "sqlite3": "^6.0.1",
    "stripe": "^22.6.1",
    "uuid": "^9.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "fintech",
    "payments",
    "settlement",
    "blockchain",
    "typescript"
  ],
  "author": "Global Pay",
  "license": "MIT"
}
